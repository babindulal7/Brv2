# Copy to .env.local and fill in. .env.local is gitignored.
#
# EVERY VARIABLE HERE IS PUBLIC. Vite inlines anything prefixed `VITE_` into the
# JavaScript bundle at build time, so all of it ships to every browser that
# loads the app and all of it is readable with View Source. There is no such
# thing as a secret in this file.
#
# ANON KEY ONLY. Never put a service key here or anywhere the client can read
# it — Row Level Security is the enforcement layer, and a service key bypasses
# it entirely. (Platform Build Instructions §7)

# ── Supabase · required ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Dev auth bypass · optional, LOCAL ONLY ───────────────────────────────────
#
# `true` skips the login screen entirely and signs you in as the seeded Owner
# (EMP-001), so `/` lands on `/today`. Read by src/lib/auth.tsx.
#
# Safe to leave documented here because the branch is double-gated on
# `import.meta.env.DEV`, which Vite makes statically `false` in a production
# build — the bypass is dead code the bundler drops, so setting this in a
# deployed environment does nothing. It exists to unblock browser verification
# when the Owner's password is unavailable, NOT as a way to run without auth.
#
# Vite reads env at server start: change this and restart, or nothing happens.
VITE_DEV_AUTH_BYPASS=

# ── Error tracking · optional ────────────────────────────────────────────────
#
# Read by src/lib/monitoring.ts. Leave it blank and captureError() no-ops:
# nothing is sent anywhere, no request is made, and the code costs ~1 kB.
#
# Set it to a Sentry (or GlitchTip / Bugsink — same envelope format) DSN and
# render crashes caught by components/shell/ErrorBoundary are reported instead
# of dying in a console nobody is watching.
#
# A DSN is a public client key by design — it can only write events — but it
# still names the project, so it is configured per environment and never
# committed. An auth token is NOT a DSN and must never go here.
VITE_SENTRY_DSN=

# ── Build identity · optional ────────────────────────────────────────────────
#
# Tags every reported error with the build it came from, which is the
# difference between "something crashed" and "the 12 Aug build crashed".
# Anything stable works: a release tag, a short commit sha, a date.
VITE_APP_VERSION=
