# Copy to .env.local and fill in. .env.local is gitignored.
#
# ANON KEY ONLY. Never put a service key in this file or anywhere the client
# can read it — Row Level Security is the enforcement layer, and a service key
# bypasses it entirely. (Platform Build Instructions §7)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
