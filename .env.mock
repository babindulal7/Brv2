# Babin Rentals OS — MOCK MODE
#
#   npm run dev:mock      → dev server against the local corpus
#   npm run build:mock    → production build against the local corpus
#
# Loaded by `vite --mode mock`. Vite's precedence is
#   .env.[mode].local > .env.[mode] > .env.local > .env
# so this file's VITE_DATA_SOURCE wins over anything in .env.local.
#
# What this does: `src/lib/supabase.ts` exports the local client from
# `src/lib/mock/` instead of a real Supabase client. No network, no project, no
# credentials — the corpus is generated by `src/lib/seed.ts` (pure and
# deterministic, so every boot is identical) and mutations are kept in a small
# localStorage replay log.
#
# Sign in with any password as:
#   owner@babinrentals.com      (Owner)
#   warehouse@babinrentals.com  (Warehouse)
#   billing@babinrentals.com    (Accounts)
#
# TO GO LIVE LATER: nothing here changes. Run the normal `npm run dev` /
# `npm run build`, which default to VITE_DATA_SOURCE=live and read
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY from .env.local as before.

VITE_DATA_SOURCE=mock
# When false or omitted, mock mode runs with clean, empty tables (all pre-seeded demo records removed).
# Set to 'true' only if you want the legacy seeded sample corpus loaded.
VITE_MOCK_SEEDED=false

# Not used in mock mode, but `.env.local` may be absent on a fresh clone and
# these keep any accidental live code path from throwing at module load.
VITE_SUPABASE_URL=http://mock.local
VITE_SUPABASE_ANON_KEY=mock-anon-key
