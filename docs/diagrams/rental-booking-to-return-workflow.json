    { "id": "return", "label": "Return and close", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["draft", "confirmed", "packed", "handed-over", "returned", "reset", "closed"],
  "nodes": [
    { "id": "draft", "lane": "desk", "col": 0, "type": "frontend", "label": "Draft rental", "sublabel": "Client, dates and lines", "width": 132 },
    { "id": "confirmed", "lane": "desk", "col": 1, "type": "backend", "label": "Confirm rental", "sublabel": "Commit booking", "width": 132 },
    { "id": "packed", "lane": "floor", "col": 2, "type": "backend", "label": "Pack equipment", "sublabel": "Verify items", "width": 132 },
    { "id": "handed-over", "lane": "floor", "col": 3, "type": "frontend", "label": "Handover", "sublabel": "Release to client", "width": 132 },
    { "id": "returned", "lane": "floor", "col": 4, "type": "frontend", "label": "Return intake", "sublabel": "Check returned items", "width": 132 },
    { "id": "reset", "lane": "floor", "col": 5, "type": "backend", "label": "Reset equipment", "sublabel": "Ready for next rental", "width": 132 },
    { "id": "closed", "lane": "desk", "col": 5, "type": "database", "label": "Close rental", "sublabel": "Terminal booking state", "width": 132 },
    { "id": "confirm-gate", "lane": "gates", "col": 1, "type": "security", "label": "Capability gate", "sublabel": "Booking desk role", "width": 132 },
