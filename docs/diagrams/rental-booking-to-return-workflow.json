    { "id": "check-close", "from": "returned", "to": "close-gate", "label": "evaluate", "variant": "security", "role": "branch" },
    { "id": "gate-close", "from": "close-gate", "to": "closed", "label": "all gates pass", "variant": "security", "role": "branch", "fromSide": "right", "toSide": "right", "route": "outside-right" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Main path", "items": ["A confirmed booking moves through packing, handover, return and reset.", "The diagram describes operational stages, not a client invoice workflow."] },
    { "dot": "rose", "title": "Gates", "items": ["Confirmation requires a permitted booking-desk role.", "Closing is checked separately after return rather than inferred from equipment reset."] }
