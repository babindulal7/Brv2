{
  "name": "babin-rentals-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "electron electron/main.cjs",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:3000 && electron electron/main.cjs\"",
    "electron:preview": "npm run build && electron electron/main.cjs --dist",
    "dev:mock": "vite --mode mock",
    "dev:local": "vite --mode localdb",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:apply": "node scripts/apply-migrations-local.mjs",
    "db:list": "node scripts/apply-migrations-local.mjs --list",
    "db:plan": "node scripts/plan-migrations.mjs",
    "db:plan:selftest": "node scripts/plan-migrations.mjs --selftest",
    "db:rebuild": "supabase db reset --no-seed && node scripts/apply-migrations-local.mjs",
    "build": "tsc --noEmit && vite build",
    "build:mock": "tsc --noEmit && vite build --mode mock",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed:sql": "node scripts/emit-seed-sql.mjs",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "check:contrast": "node scripts/check-contrast.cjs",
    "check:db": "node scripts/check-db.mjs",
    "check:rebuild": "node scripts/check-rebuild.mjs",
    "check:pglite": "node scripts/check-pglite.mjs",
    "check:lifecycle": "node scripts/e2e-lifecycle.mjs",
    "check:dump": "node scripts/check-dump.mjs",
    "completion": "node scripts/completion.mjs",
    "lint:progress": "node scripts/lint-progress.mjs",
    "lint:shell": "node scripts/check-page-shell-lint.mjs",
    "db:local": "node scripts/local-db.mjs",
    "storage:local": "node scripts/local-storage.mjs",
    "data:wipe": "node scripts/wipe-user-data.mjs",
    "check:anon": "node scripts/check-anon-exposure.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/asar": "^5.3.0",
    "@fontsource/hind": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.47.10",
    "@tabler/icons-react": "^3.46.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "dexie": "^4.4.4",
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "pg": "^8.23.1",
    "supabase": "^2.114.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.11",
    "vitest": "^3.2.7",
    "wait-on": "^9.1.0"
  }
}
